  "item": [
    {
      "name": "Linear regression",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"inputs\": [{\n    \"name\": \"X\", \"shape\": [3, 1], \"datatype\": \"FP32\", \"data\": [40, 50, 60]\n  }],\n  \"outputs\": [{\"name\": \"Y\"}]\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{baseUrl}}/v2/models/linear_regression/infer", "host": ["{{baseUrl}}"], "path": ["v2", "models", "linear_regression", "infer"]}
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('Returns three finite predictions', function () { const values = body.outputs[0].data; pm.expect(values).to.be.an('array').with.lengthOf(3); values.forEach(function (v) { pm.expect(v).to.be.a('number').and.to.be.finite; }); });"]}}],
      "response": []
    },
