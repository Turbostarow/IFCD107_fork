{
  "info": {
    "name": "API de regresión polinómica y Random Forest",
    "description": "Health, autenticación Bearer, regresión polinómica y Random Forest (demo de terrazas y CSV multipart). Ejecuta Obtener token antes de entrenar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "reference",
      "value": "terrazas_madrid_demo"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Obtener token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Credenciales aceptadas\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().access_token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/token"
      }
    },
    {
      "name": "Ajustar desde JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reference\": \"{{reference}}\",\n  \"degree\": 2,\n  \"data\": [\n    {\"x\": -3, \"y\": 10.1},\n    {\"x\": -2, \"y\": 5.9},\n    {\"x\": -1, \"y\": 2.2},\n    {\"x\": 0, \"y\": 1.0},\n    {\"x\": 1, \"y\": 1.8},\n    {\"x\": 2, \"y\": 6.2},\n    {\"x\": 3, \"y\": 10.0},\n    {\"x\": 4, \"y\": 17.1}\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/regresion/polinomica"
      }
    },
    {
      "name": "Ajustar desde CSV",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "reference",
              "value": "{{reference}}",
              "type": "text"
            },
            {
              "key": "degree",
              "value": "2",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": "../ejemplos/datos_ejemplo.csv"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/regresion/polinomica/csv",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ]
      }
    },
    {
      "name": "Random Forest - CSV de terrazas incluido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reference\": \"terrazas_rf_demo\",\n  \"target\": \"y\",\n  \"n_estimators\": 200,\n  \"max_depth\": null,\n  \"test_size\": 0.2,\n  \"random_state\": 42\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/random-forest/terrazas"
      }
    },
    {
      "name": "Random Forest - cargar CSV",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "reference",
              "value": "terrazas_rf_csv_demo",
              "type": "text"
            },
            {
              "key": "target",
              "value": "y",
              "type": "text"
            },
            {
              "key": "n_estimators",
              "value": "200",
              "type": "text"
            },
            {
              "key": "max_depth",
              "value": "",
              "type": "text"
            },
            {
              "key": "test_size",
              "value": "0.2",
              "type": "text"
            },
            {
              "key": "random_state",
              "value": "42",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": "../ejemplos/datos_ejemplo_complejo.csv"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/random-forest/csv"
      }
    }
  ]
}
